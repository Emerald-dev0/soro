# =============================================================================
# SORO — environment template (Phase 0)
# =============================================================================
# Copy to `.env` for local development:
#
#   cp .env.example .env
#
# Rules:
#   - NEVER commit `.env` (it is git-ignored).
#   - NEVER put real credentials in this file.
#   - Every variable is documented in docs/ENVIRONMENT.md.
#
# Legend per variable:
#   LOCAL = required for local development?
#   DEMO  = required for Demo Mode?
#   LIVE  = required for Live Mode?
# =============================================================================

# ---------------------------------------------------------------- APPLICATION
# Human-readable app name. LOCAL: optional | DEMO: no | LIVE: no
SORO_APP_NAME=Soro

# Runtime environment label. LOCAL: yes | DEMO: no | LIVE: no
SORO_ENV=local

# Default operating mode: "demo" or "live".
# Demo Mode is deterministic and needs no external services.
# LOCAL: yes | DEMO: no (forced to demo) | LIVE: yes (set to live)
SORO_MODE=demo

# HTTP port for local services / webhooks. LOCAL: yes | DEMO: no | LIVE: yes
SORO_PORT=3000

# Log verbosity: debug | info | warn | error. LOCAL: optional | DEMO: no | LIVE: no
SORO_LOG_LEVEL=info

# ------------------------------------------------------------------- DATABASE
# Filesystem path for the local SQLite database (Phase 0 uses node:sqlite,
# zero external setup). LOCAL: yes | DEMO: yes | LIVE: yes (local live-test)
SORO_DATABASE_PATH=./data/soro.db

# ------------------------------------------------------------------------ LLM
# LLM provider id (e.g. openai). STATUS: PLANNED — no live calls in Phase 0.
# LOCAL: no | DEMO: no (scenario engine is deterministic) | LIVE: yes (planned)
SORO_LLM_PROVIDER=
SORO_LLM_API_KEY=
SORO_LLM_MODEL=

# --------------------------------------------------------------------- TWILIO
# Twilio account credentials for Live Mode voice. STATUS: NOT YET TESTED.
# LOCAL: only for live-call testing (requires tunnel, see docs/TWILIO.md)
# DEMO: no | LIVE: yes
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public base URL Twilio can reach for webhooks (e.g. ngrok URL + path prefix).
TWILIO_WEBHOOK_BASE_URL=http://localhost:3000

# ----------------------------------------------------------------------- WEMA
# Wema/ALAT OpenAPI credentials. STATUS: NOT VERIFIED — see docs/WEMA.md.
# Do NOT invent endpoints. LOCAL: no | DEMO: no | LIVE: yes (once verified)
WEMA_ENV=sandbox
WEMA_BASE_URL=
WEMA_CLIENT_ID=
WEMA_CLIENT_SECRET=
WEMA_API_KEY=

# ------------------------------------------------------------------------ STT
# Speech-to-text provider. STATUS: PLANNED — see docs/VOICE.md.
# LOCAL: no | DEMO: no | LIVE: yes (planned)
SORO_STT_PROVIDER=
SORO_STT_API_KEY=

# ------------------------------------------------------------------------ TTS
# Text-to-speech provider for Ayo's voice. STATUS: PLANNED — docs/VOICE.md.
# LOCAL: no | DEMO: no | LIVE: yes (planned)
SORO_TTS_PROVIDER=
SORO_TTS_API_KEY=
SORO_TTS_VOICE=

# ---------------------------------------------------------------------------
# Phase 1 hackathon additions
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon). NOTE: the current runtime uses local
# SQLite via node:sqlite (see ADR-0010/0013). DATABASE_URL is reserved for the
# planned Postgres migration; do not point it at production data.
DATABASE_URL=

# Force demo mode (never show simulated data as live).
DEMO_MODE=true

# Email provider (statement delivery). Demo mode logs instead of sending.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# AI provider for Ayo reasoning (deterministic demo NLU is used when empty).
AI_PROVIDER_API_KEY=
AI_MODEL=

# Session/auth secrets (never commit real values).
SESSION_SECRET=
ENCRYPTION_KEY=
# Shared secret used to sign/verify internal admin callbacks and demo headers.
WEBHOOK_SECRET=

# Public base URL for Twilio webhooks (ngrok/cloudflared during dev).
APP_BASE_URL=http://localhost:3000
