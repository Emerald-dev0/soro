{
  "name": "@soro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Soro backend HTTP API: Twilio webhooks, dashboard APIs, SSE event stream, demo scenario runner",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run tests src",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@soro/banking": "workspace:*",
    "@soro/config": "workspace:*",
    "@soro/db": "workspace:*",
    "@soro/events": "workspace:*",
    "@soro/service-agent": "workspace:*",
    "@soro/service-security": "workspace:*",
    "@soro/types": "workspace:*",
    "fastify": "^5.0.0",
    "tsx": "^4.23.15",
    "twilio": "^5.0.0"
  }
}