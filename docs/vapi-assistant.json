        "function": {
          "name": "getAccountBalance",
          "description": "Get the authenticated account balance.",
          "parameters": {
            "type": "object",
            "properties": {
              "amount_minor": {
                "type": "number",
                "description": "Amount in kobo (₦1 = 100 kobo)"
              },
              "network": {
                "type": "string",
                "enum": [
                  "MTN",
                  "AIRTEL",
                  "GLO",
                  "9MOBILE"
                ]
              },
              "reference": {
                "type": "string",
                "description": "Transfer reference"
              },
              "account_number": {
                "type": "string",
