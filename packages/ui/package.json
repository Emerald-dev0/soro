{
  "name": "@soro/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Soro shared UI primitives: Ayo state metadata, mode badges (Phase 0 foundation)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "echo \"@soro/ui: library package (no dev server)\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run tests src"
  },
  "dependencies": {
    "@soro/types": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components.tsx",
    "./styles/*": "./styles/*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}